# Local Docker runtime for the Intake Genie compiler (SiteForge server).
# The server core is zero-dependency, but app/lib/engine-adapter.mjs imports
# jsdom/sharp-family packages at boot, so the lockfile install ships too.
#   docker build -f Dockerfile.local -t wss-intake-compiler:local .
FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY . .
RUN corepack enable && pnpm install --frozen-lockfile --ignore-scripts
# Preview quality checks launch Playwright inside this container.
RUN pnpm exec playwright install --with-deps --only-shell chromium
RUN mkdir -p /data
ENV SITEFORGE_DATA_DIR=/data
VOLUME ["/data"]
EXPOSE 8787
CMD ["node", "app/server.mjs"]
