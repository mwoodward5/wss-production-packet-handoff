{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BespokeSiteOS Packet v5",
  "type": "object",
  "required": ["slug", "business", "hero_family", "layout_seed", "enrichment_sources", "voice_persona"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "business": {
      "type": "object",
      "required": ["name", "category", "city", "state"],
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string", "minLength": 2, "maxLength": 2 },
        "current_website": { "type": ["string", "null"], "format": "uri" },
        "gbp_url": { "type": ["string", "null"], "format": "uri" },
        "source_platform": {
          "type": "string",
          "enum": ["wordpress", "wix", "squarespace", "godaddy", "none", "other"]
        }
      }
    },
    "build_type": {
      "type": "string",
      "enum": ["landing", "multi-page", "service-detail", "full-site"]
    },
    "toggles": {
      "type": "object",
      "properties": {
        "firecrawl": { "type": "boolean" },
        "gbp": { "type": "boolean" },
        "local_serp": { "type": "boolean" },
        "video_prompt": { "type": "boolean" },
        "map": { "type": "boolean" },
        "ai_chat": { "type": "boolean" },
        "payment_cta": { "type": "boolean" }
      }
    },
    "hero_family": {
      "type": "string",
      "enum": [
        "cinematic-video-parallax",
        "split-editorial-index",
        "service-map-pins",
        "material-lab-swatch",
        "magazine-owner-letter",
        "atlas-grid-reveal"
      ]
    },
    "layout_seed": { "type": "string" },
    "motif": { "type": "string" },
    "section_plan": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string" }
    },
    "logo_source": {
      "type": "object",
      "properties": {
        "url": { "type": ["string", "null"], "format": "uri" },
        "origin": { "type": "string", "enum": ["gbp", "firecrawl", "upload", "proposed"] },
        "proposed": { "type": "boolean" },
        "remastered_path": { "type": ["string", "null"] }
      }
    },
    "voice_persona": {
      "type": "object",
      "required": ["owner_name", "tone"],
      "properties": {
        "owner_name": { "type": "string" },
        "years_in_biz": { "type": ["integer", "null"] },
        "first_person_snippets": { "type": "array", "items": { "type": "string" } },
        "tone": { "type": "string" }
      }
    },
    "enrichment_sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["source", "confidence"],
        "properties": {
          "source": { "type": "string", "enum": ["firecrawl", "firecrawl-branding", "gbp", "serp", "manual", "upload"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "value": {}
        }
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "hero_video_url": { "type": ["string", "null"] },
        "hero_still_url": { "type": ["string", "null"] },
        "gallery": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
