{
  "$schema": "https://wss-ai.com/schemas/mirror-manifest-1.json",
  "manifestVersion": 1,
  "template": {
    "name": "wss-plumber-trust-template",
    "stack": "tanstack-start + tailwind4 + wss-trust-widgets",
    "vertical": "plumbing",
    "verticalPresets": [
      "plumbing",
      "hvac",
      "roofing",
      "electrical",
      "landscaping",
      "cleaning",
      "autoRepair",
      "dental",
      "medspa",
      "salon",
      "tattoo",
      "legal",
      "restaurant"
    ]
  },
  "writeTargets": [
    {
      "path": "src/trust.config.ts",
      "role": "facts",
      "description": "Ratings, reviews, credentials, hours, geo, services, stats, gallery. Never invent a value; omit it and the widget renders nothing.",
      "export": "trustConfig"
    },
    {
      "path": "src/client.config.ts",
      "role": "brand",
      "description": "Wordmark, logo path, Google Fonts families, oklch palette, hero mode + media, Google Place ID, review-request copy, provenance.",
      "export": "clientConfig"
    },
    {
      "path": "public/brand/logo.png",
      "role": "asset",
      "description": "Square brand mark. Also resized to public/favicon.png."
    },
    {
      "path": "public/hero/still-{1,2,3}.jpg",
      "role": "asset",
      "description": "1920x1080 Ken Burns stills. Replaced by hero.videoSrc when hero.mode is 'video'."
    },
    {
      "path": "public/gallery/*.jpg",
      "role": "asset",
      "description": "Portfolio / before-after imagery referenced by trustConfig.proof.gallery."
    }
  ],
  "neverEdit": [
    "src/routes/**",
    "src/components/**",
    "src/trust-widgets/**",
    "src/styles.css"
  ],
  "themeTokens": {
    "source": "clientConfig.brand.palette",
    "format": "oklch",
    "keys": ["background", "cream", "petrolDeep", "coral", "mint"],
    "appliedIn": "src/styles.css :root — the mirroring engine substitutes the five values in place"
  },
  "hero": {
    "modes": ["kenburns", "video"],
    "videoRequirements": {
      "codec": "h264 mp4",
      "maxSeconds": 18,
      "maxMB": 8,
      "audio": "none (muted autoplay)",
      "posterRequired": true
    },
    "stillRequirements": { "count": 3, "size": "1920x1080", "format": "jpg" }
  },
  "dataRefresh": {
    "endpoint": "/api/public/refresh-proof",
    "method": "POST",
    "auth": { "header": "apikey", "value": "SUPABASE_PUBLISHABLE_KEY" },
    "body": {
      "siteKey": "string (matches clientConfig.siteKey)",
      "placeId": "string (Google Place ID, optional)",
      "scrapeUrls": [{ "platform": "Yelp", "url": "https://…" }]
    },
    "tables": ["reviews", "ratings_snapshots", "refresh_runs"],
    "schedule": "pg_cron daily 04:20 UTC — see MIRROR.md §6"
  },
  "generatedRoutes": [
    { "path": "/", "source": "src/routes/index.tsx" },
    {
      "path": "/plumber/$area",
      "source": "src/routes/plumber.$area.tsx",
      "expandsFrom": "trustConfig.location.serviceAreas"
    },
    { "path": "/llms.txt", "role": "AI answer-engine brief" },
    { "path": "/sitemap.xml", "role": "sitemap incl. every service area page" }
  ],
  "requiredSecrets": {
    "FIRECRAWL_API_KEY": "connector — scraping (gateway or direct, auto-detected)",
    "GOOGLE_MAPS_API_KEY": "connector — Places API (New) reviews + geocoding",
    "LOVABLE_API_KEY": "connector gateway auth",
    "VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY": "browser map embed (optional; keyless embed fallback)"
  },
  "markerToken": {
    "grep": "MIRROR:",
    "meaning": {
      "MIRROR:TEMPLATE-CODE": "Do not edit this file per client. Its header block names the config keys that drive it and where each value is scraped from.",
      "MIRROR:PALETTE": "The only block in src/styles.css a mirroring run rewrites (five oklch brand tokens)."
    },
    "findAll": "rg -n 'MIRROR:' src"
  },
  "placeholders": [
    { "key": "clientConfig.siteKey", "file": "src/client.config.ts", "type": "string", "required": true, "source": "engine", "path": "slugify(business name + city)", "fallback": "none — required for review-row scoping" },
    { "key": "clientConfig.canonicalUrl", "file": "src/client.config.ts", "type": "url", "required": true, "source": "engine", "path": "https://{slug}.your-domain.com", "fallback": "none — canonical + sitemap + JSON-LD depend on it" },
    { "key": "clientConfig.brand.wordmark", "file": "src/client.config.ts", "type": "string", "required": true, "source": "places.details", "path": "displayName.text", "fallback": "none" },
    { "key": "clientConfig.brand.wordmarkSub", "file": "src/client.config.ts", "type": "string", "required": false, "source": "firecrawl.scrape", "path": "metadata.description (first clause)", "fallback": "second header line hidden" },
    { "key": "clientConfig.brand.logoSrc", "file": "src/client.config.ts", "type": "asset", "required": false, "source": "firecrawl.scrape", "path": "branding.logo -> download to public/brand/logo.png", "fallback": "monogram mark generated from wordmark initials" },
    { "key": "clientConfig.brand.logoScale", "file": "src/client.config.ts", "type": "number", "required": false, "source": "engine", "path": "1 = 34px baseline; 2 = current build", "fallback": "1" },
    { "key": "clientConfig.brand.fonts", "file": "src/client.config.ts", "type": "object", "required": true, "source": "firecrawl.scrape", "path": "branding.typography.fontFamilies -> nearest Google Fonts family", "fallback": "donor families" },
    { "key": "clientConfig.brand.palette", "file": "src/client.config.ts + src/styles.css MIRROR:PALETTE", "type": "oklch[5]", "required": true, "source": "firecrawl.scrape", "path": "branding.colors.{background,textPrimary,primary,accent} hex -> oklch", "fallback": "donor palette" },
    { "key": "clientConfig.hero.mode", "file": "src/client.config.ts", "type": "enum(video|kenburns)", "required": true, "source": "engine", "path": "video when a reel exists, else kenburns", "fallback": "kenburns" },
    { "key": "clientConfig.hero.videoSrc", "file": "public/hero/hero.mp4", "type": "asset", "required": false, "source": "engine", "path": "h264 mp4, <=18s, <=8MB, muted", "fallback": "stills sequence" },
    { "key": "clientConfig.hero.videoPoster", "file": "public/hero/poster.jpg", "type": "asset", "required": false, "source": "engine", "path": "first frame of hero.mp4", "fallback": "stills[0]" },
    { "key": "clientConfig.hero.stills", "file": "public/hero/still-*.jpg", "type": "asset[]", "required": true, "source": "places.details", "path": "photos[] media download, else generated 1920x1080", "fallback": "none — hero needs at least one still" },
    { "key": "clientConfig.hero.kicker|headline|headlineAccent|sub", "file": "src/client.config.ts", "type": "string", "required": true, "source": "firecrawl.scrape", "path": "h1 + hero paragraph from markdown", "fallback": "business.category + serviceAreas[0]" },
    { "key": "clientConfig.maps.placeId", "file": "src/client.config.ts", "type": "string", "required": true, "source": "places.textsearch", "path": "places[0].id", "fallback": "review composer + live refresh disabled" },
    { "key": "clientConfig.reviewRequest.*", "file": "src/client.config.ts", "type": "object", "required": false, "source": "engine", "path": "phrases must name real services[]", "fallback": "panel hidden" },
    { "key": "trustConfig.business.name|legalName", "file": "src/trust.config.ts", "type": "string", "required": true, "source": "places.details", "path": "displayName.text", "fallback": "none" },
    { "key": "trustConfig.business.schemaType", "file": "src/trust.config.ts", "type": "schema.org type", "required": true, "source": "engine", "path": "Plumber | HVACBusiness | RoofingContractor | …", "fallback": "LocalBusiness" },
    { "key": "trustConfig.business.category|tagline|description", "file": "src/trust.config.ts", "type": "string", "required": true, "source": "firecrawl.scrape", "path": "primaryTypeDisplayName + site markdown intro", "fallback": "category from Places type" },
    { "key": "trustConfig.business.url", "file": "src/trust.config.ts", "type": "url", "required": true, "source": "places.details", "path": "websiteUri", "fallback": "canonicalUrl" },
    { "key": "trustConfig.business.foundingYear", "file": "src/trust.config.ts", "type": "string", "required": false, "source": "firecrawl.scrape", "path": "\"since 19xx\" / \"founded\" match in markdown", "fallback": "years-in-business stat omitted" },
    { "key": "trustConfig.contact.phone|phoneDisplay", "file": "src/trust.config.ts", "type": "string", "required": true, "source": "places.details", "path": "internationalPhoneNumber (E.164) / nationalPhoneNumber", "fallback": "call CTAs hidden" },
    { "key": "trustConfig.contact.bookingUrl|quoteUrl", "file": "src/trust.config.ts", "type": "url", "required": false, "source": "firecrawl.scrape", "path": "links[] matching /book|schedule|appointment|contact/", "fallback": "phone-only CTAs" },
    { "key": "trustConfig.location.primary.*", "file": "src/trust.config.ts", "type": "object", "required": true, "source": "places.details", "path": "addressComponents + location.latitude/longitude + googleMapsUri", "fallback": "map, directions and GeoCoordinates JSON-LD omitted" },
    { "key": "trustConfig.location.serviceAreas", "file": "src/trust.config.ts", "type": "string[]", "required": true, "source": "firecrawl.scrape", "path": "service-area page / footer city list", "fallback": "near-me pages and areaServed omitted" },
    { "key": "trustConfig.hours.weekly", "file": "src/trust.config.ts", "type": "object[]", "required": true, "source": "places.details", "path": "regularOpeningHours.periods[]", "fallback": "OpenNowStatus hidden" },
    { "key": "trustConfig.proof.ratings[]", "file": "src/trust.config.ts", "type": "object[]", "required": true, "source": "places.details", "path": "rating + userRatingCount + googleMapsUri (Yelp/Facebook via firecrawl.scrape)", "fallback": "star bars and AggregateRating omitted — never fabricate" },
    { "key": "trustConfig.proof.reviews[]", "file": "src/trust.config.ts", "type": "object[]", "required": true, "source": "places.details", "path": "reviews[]: text.text, rating, relativePublishTimeDescription, authorAttribution.displayName, authorAttribution.photoUri -> avatarUrl", "fallback": "review walls, marquee and face piles hidden" },
    { "key": "trustConfig.proof.credentials[]", "file": "src/trust.config.ts", "type": "object[]", "required": false, "source": "licence-board", "path": "state board licence search + insurance/bond text on site", "fallback": "credential wall hidden" },
    { "key": "trustConfig.proof.guarantees[]|badges[]|awards[]|press[]", "file": "src/trust.config.ts", "type": "object[]", "required": false, "source": "firecrawl.scrape", "path": "warranty / guarantee / BBB / award mentions", "fallback": "each rail hides itself" },
    { "key": "trustConfig.proof.stats[]", "file": "src/trust.config.ts", "type": "object[]", "required": false, "source": "derived", "path": "years in business, review count, avg response time — only if provable", "fallback": "counter band hidden" },
    { "key": "trustConfig.proof.gallery[]|beforeAfter[]", "file": "public/gallery/*.jpg", "type": "asset[]", "required": false, "source": "places.details", "path": "photos[] media download, re-hosted", "fallback": "gallery and slider hidden" },
    { "key": "trustConfig.services[]", "file": "src/trust.config.ts", "type": "object[]", "required": true, "source": "firecrawl.map+scrape", "path": "/services/* pages: name, description, priceFrom/priceTo", "fallback": "service menu and Offer schema omitted" },
    { "key": "trustConfig.voice.answers[]", "file": "src/trust.config.ts", "type": "object[]", "required": true, "source": "engine", "path": "1-2 factual sentences per near-me question, built only from the facts above", "fallback": "Speakable + FAQPage omitted" },
    { "key": "trustConfig.availability.*", "file": "src/trust.config.ts", "type": "object", "required": false, "source": "firecrawl.scrape", "path": "24/7 or emergency claims on the site", "fallback": "emergency band and capacity meter hidden" },
    { "key": "trustConfig.social.accounts[]", "file": "src/trust.config.ts", "type": "object[]", "required": false, "source": "firecrawl.scrape", "path": "links[] matching social hosts", "fallback": "follower bar hidden" }
  ],
  "emptyConfigSafe": true
}
