{
  "project_name": "Paragon Flight Training",
  "vertical": "Aviation & Flight Training Academy",
  "classification": "Multi-page",
  "routes": [
    {
      "path": "/",
      "component": "src/pages/Index.tsx",
      "purpose": "Flagship authority homepage and conversion nexus"
    },
    {
      "path": "/service-areas",
      "component": "src/pages/ServiceAreasHub.tsx",
      "purpose": "Regional directory indexing all cities and training syllabi"
    },
    {
      "path": "/flight-school/:city",
      "component": "src/pages/CityLanding.tsx",
      "purpose": "Localized service-area landing pages for surrounding cities"
    },
    {
      "path": "/programs/:program",
      "component": "src/pages/ProgramLanding.tsx",
      "purpose": "Course-specific landing pages for individual FAA ratings"
    }
  ],
  "design_tokens": {
    "colors": {
      "background": "hsl(215 45% 7%)",
      "foreground": "hsl(200 20% 96%)",
      "surface": "hsl(215 40% 10%)",
      "surface_elevated": "hsl(215 38% 13%)",
      "primary": "hsl(38 92% 56%)",
      "primary_glow": "hsl(42 100% 65%)",
      "secondary_instrument": "hsl(195 85% 50%)",
      "border": "hsl(215 30% 18%)",
      "horizon": "hsl(28 95% 55%)"
    },
    "typography": {
      "display": "Barlow Condensed, Oswald, sans-serif",
      "body": "Public Sans, system-ui, sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "radii": {
      "default": "0.25rem",
      "button": "0.25rem",
      "pill_exceptions": [
        "status-pings",
        "sticky-cta"
      ]
    }
  },
  "hero_contract": {
    "dimensions": "min-h-[100svh] w-full",
    "media_layer": "absolute inset-0 -z-20 with scroll parallax & spring pointer movement",
    "video_ready": true,
    "video_drop_paths": [
      "/public/hero/paragon-hero.mp4",
      "/public/hero/paragon-hero.webm"
    ],
    "poster_fallback": "src/assets/hero-poster.jpg",
    "overlay_stack": [
      "linear-gradient(180deg, hsl(215 50% 8% / 0.2) 0%, hsl(215 50% 8% / 0.95) 100%)",
      "radial-gradient(ellipse at bottom, hsl(var(--sky-deep)/0.95), transparent 70%)",
      "animated horizon drift glow",
      "animated windshield glare light sweep",
      "animated SVG flight path"
    ],
    "hud_elements": [
      "live altitude / heading / airspeed telemetry",
      "scramble text accent animation",
      "dual magnetic control buttons"
    ]
  },
  "media_slots": [
    {
      "slot_id": "hero-bg",
      "route": "/",
      "section": "Hero",
      "semantic_role": "hero",
      "recommended_client_photo": "Aircraft in flight over local coastline or flagship fleet ramp",
      "aspect_ratio": "16:9",
      "crop_behavior": "object-cover [object-position:60%_center] sm:[object-position:center]"
    },
    {
      "slot_id": "pathway-pilot",
      "route": "/",
      "section": "Pathway",
      "semantic_role": "team/equipment",
      "recommended_client_photo": "Student pilot and CFI during preflight or cockpit instruction",
      "aspect_ratio": "4:3",
      "crop_behavior": "object-cover with HUD corner brackets"
    },
    {
      "slot_id": "discovery-view",
      "route": "/",
      "section": "Discovery",
      "semantic_role": "service/work",
      "recommended_client_photo": "Cockpit POV looking out over local regional landmarks",
      "aspect_ratio": "16:10",
      "crop_behavior": "object-cover with live telemetry overlay"
    },
    {
      "slot_id": "campus-aeronautical",
      "route": "/",
      "section": "CampusMap",
      "semantic_role": "facility/location",
      "recommended_client_photo": "Aerial or ramp perspective of base airport and hangar",
      "aspect_ratio": "4:3",
      "crop_behavior": "object-cover under aeronautical HUD overlay"
    },
    {
      "slot_id": "flightscene-bg",
      "route": "/",
      "section": "FlightScene",
      "semantic_role": "ambient",
      "recommended_client_photo": "Single aircraft banking into evening clouds",
      "aspect_ratio": "16:9",
      "crop_behavior": "object-cover inside sticky 260vh scroll stage"
    },
    {
      "slot_id": "contact-cockpit",
      "route": "/",
      "section": "Contact",
      "semantic_role": "equipment",
      "recommended_client_photo": "Glass cockpit avionics close-up",
      "aspect_ratio": "16:9",
      "crop_behavior": "object-cover in left admissions info column"
    }
  ],
  "content_slots": [
    {
      "entity": "business_name",
      "targets": [
        "SITE.name in src/data/local.ts",
        "src/pages/Index.tsx",
        "src/components/Nav.tsx",
        "src/components/Footer.tsx"
      ]
    },
    {
      "entity": "phone_numbers",
      "targets": [
        "SITE.phone",
        "SITE.phoneDisplay",
        "SITE.phoneTel",
        "SITE.smsHref"
      ]
    },
    {
      "entity": "physical_address",
      "targets": [
        "src/components/CampusMap.tsx",
        "src/components/Contact.tsx",
        "Schema @graph PostalAddress"
      ]
    },
    {
      "entity": "service_cities",
      "targets": [
        "CITIES array in src/data/local.ts (slug, name, drive, minutes, intro, paragraphs, landmarks)"
      ]
    },
    {
      "entity": "training_programs",
      "targets": [
        "PROGRAMS array in src/data/local.ts",
        "programs list in src/components/Programs.tsx"
      ]
    }
  ],
  "trust_slots": [
    {
      "type": "faa_checkride_badges",
      "location": "src/components/MissionControl.tsx",
      "style": "Monospace high-contrast flight-strip status badges"
    },
    {
      "type": "google_aggregate_rating",
      "location": "src/components/Hero.tsx & src/components/Contact.tsx",
      "style": "Conditional rating pill, proof-gated on verified Place ID"
    },
    {
      "type": "airport_infrastructure_data",
      "location": "src/components/CampusMap.tsx",
      "style": "4-item HUD telemetry grid (ICAO, Field Name, City, Region)"
    }
  ],
  "schema_slots": [
    {
      "type": "LocalBusiness / EducationalOrganization",
      "file": "src/pages/Index.tsx",
      "id": "https://fort-myers-paragonflight.wss-ai.com/#org"
