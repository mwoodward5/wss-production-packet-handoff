    },
    {
      "type": "Service",
      "file": "src/pages/CityLanding.tsx",
      "description": "Regional flight training service definition"
    },
    {
      "type": "FAQPage",
      "file": "src/pages/Index.tsx & src/pages/CityLanding.tsx",
