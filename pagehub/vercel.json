{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/healthz",
      "dest": "/api/intake-genie-compile.js?healthz=1"
    },
    {
      "src": "/api/intake-genie/compile",
      "dest": "/api/intake-genie-compile.js"
    },
    {
      "src": "/api/intake-genie/import-packet2",
      "dest": "/api/intake-genie-import-packet2.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
