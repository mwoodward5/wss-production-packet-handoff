# Local-first runtime image for the WSS backend (apps/backend).
# The backend code runs UNMODIFIED — this image is a plain Node 22 runtime with
# its npm dependencies and a chromium for the in-process render gate.
# The Vercel-compatible local HTTP shim is mounted at runtime from
# infra/backend/ (see docker-compose.yml) so it never bakes into the image.
FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    NODE_PATH=/app/node_modules

# ffmpeg: hero/video pipeline; curl/wget: container healthchecks.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg procps \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Playwright chromium for the render gate / capture stack (local lane —
# GHOST_AGENCY_REMOTE_BROWSER stays unset so no Firecrawl browser sessions).
RUN npx playwright install --with-deps chromium

COPY . .

EXPOSE 3000
CMD ["node", "/opt/local-server.cjs"]
